<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_10yonzd" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_0hy068t">
    <bpmn:participant id="Participant_1fsoitw" name="Student Project Approval &#38; Allocation" processRef="Process_0lu5wsg" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_Withdraw" name="teamWithdrawalOrGuideCancellation">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=teamId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_SlotFreed" name="guideSlotFreed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=teamId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Err_Notify" name="Notification or recording error" errorCode="NOTIFY_OR_RECORD_FAILED" />
  <bpmn:process id="Process_0lu5wsg" name="Student Project Approval &#38; Allocation" isExecutable="true">
    <bpmn:laneSet id="LaneSet_11k6wn6">
      <bpmn:lane id="Lane_Student" name="Student / Team">
        <bpmn:flowNodeRef>Start_Team</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Modify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_RevDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LateRev</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinator" name="Project Coordinator">
        <bpmn:flowNodeRef>Task_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Override</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ClosedInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewDup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Modify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewLate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MissedRev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_LateRev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LapsedRev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Shortage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Alt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Team_correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualNotify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Review Committee (including HoD)">
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Escal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HoD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RevLimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Final</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guide" name="Faculty Guide">
        <bpmn:flowNodeRef>Task_GuideReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_GuideTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Withdraw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Accepted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Project Management System">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Resub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TeamRule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvalidTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Dup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyDup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Dup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Missed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reminded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EBG_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Slot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Unavail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Exclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Withdraw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Allocated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Team</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Team" name="Team decides to submit proposal">
      <bpmn:outgoing>Flow_Team__Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Submit" name="Submit project proposal">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_SubmitProjectProposal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Team__Submit</bpmn:incoming>
      <bpmn:incoming>Flow_Modify__Submit</bpmn:incoming>
      <bpmn:incoming>Flow_Late__Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit__Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BE_Deadline" name="Submission deadline expired" attachedToRef="Task_Submit">
      <bpmn:outgoing>Flow_Deadline__Missed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BE_Deadline_def">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">=submissionDeadline</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Validate" name="Validate proposal and team rules">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-proposal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Submit__Validate</bpmn:incoming>
      <bpmn:incoming>Flow_Correct__Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate__Valid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Valid" name="Proposal valid?" default="Flow_Valid__Resub">
      <bpmn:incoming>Flow_Validate__Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid__Screen</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid__TeamRule</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid__Resub</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Resub" name="Resubmission limit reached?" default="Flow_Resub__Escalate">
      <bpmn:incoming>Flow_Valid__Resub</bpmn:incoming>
      <bpmn:outgoing>Flow_Resub__SendErrors</bpmn:outgoing>
      <bpmn:outgoing>Flow_Resub__Escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendErrors" name="Send validation error list">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-validation-errors" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Resub__SendErrors</bpmn:incoming>
      <bpmn:outgoing>Flow_SendErrors__Correct</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_Correct" name="Correct proposal">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_CorrectProposal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SendErrors__Correct</bpmn:incoming>
      <bpmn:outgoing>Flow_Correct__Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_TeamRule" name="Notify student of team rule violation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-team-rule-violation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid__TeamRule</bpmn:incoming>
      <bpmn:outgoing>Flow_TeamRule__InvalidTeam</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_InvalidTeam" name="Invalid team">
      <bpmn:incoming>Flow_TeamRule__InvalidTeam</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Escalate" name="Review repeatedly failed proposal">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ReviewRepeatedFailure" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Resub__Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate__Override</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Override" name="Accept for screening?" default="Flow_Override__ClosedInvalid">
      <bpmn:incoming>Flow_Escalate__Override</bpmn:incoming>
      <bpmn:outgoing>Flow_Override__Screen</bpmn:outgoing>
      <bpmn:outgoing>Flow_Override__ClosedInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ClosedInvalid" name="Closed: invalid proposal">
      <bpmn:incoming>Flow_Override__ClosedInvalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Screen" name="Screen proposal">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ScreenProposal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid__Screen</bpmn:incoming>
      <bpmn:incoming>Flow_Override__Screen</bpmn:incoming>
      <bpmn:outgoing>Flow_Screen__Dup</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Dup" name="Check duplicate / similar topics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-duplicate-topic" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Screen__Dup</bpmn:incoming>
      <bpmn:outgoing>Flow_Dup__Dup</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Dup" name="Duplicate found?" default="Flow_Dup__Evaluate">
      <bpmn:incoming>Flow_Dup__Dup</bpmn:incoming>
      <bpmn:outgoing>Flow_Dup__Evaluate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Dup__ReviewDup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviewDup" name="Review duplicate match">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ReviewDuplicateMatch" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Dup__ReviewDup</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewDup__Modify</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Modify" name="Can topic be modified?" default="Flow_Modify__NotifyDup">
      <bpmn:incoming>Flow_ReviewDup__Modify</bpmn:incoming>
      <bpmn:outgoing>Flow_Modify__Modify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Modify__NotifyDup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Modify" name="Modify project topic">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ModifyProjectTopic" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Modify__Modify</bpmn:incoming>
      <bpmn:outgoing>Flow_Modify__Submit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_NotifyDup" name="Notify student of duplicate topic rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-duplicate-rejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Modify__NotifyDup</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyDup__Dup</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Dup" name="Duplicate topic rejected">
      <bpmn:incoming>Flow_NotifyDup__Dup</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_Missed" name="Notify student of missed deadline">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-missed-deadline" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Deadline__Missed</bpmn:incoming>
      <bpmn:outgoing>Flow_Missed__ReviewLate</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_ReviewLate" name="Review late submission request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ReviewLateSubmission" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Missed__ReviewLate</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewLate__Late</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Late" name="Late submission approved?" default="Flow_Late__Lapsed">
      <bpmn:incoming>Flow_ReviewLate__Late</bpmn:incoming>
      <bpmn:outgoing>Flow_Late__Submit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Late__Lapsed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Lapsed" name="Submission lapsed">
      <bpmn:incoming>Flow_Late__Lapsed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Evaluate" name="Evaluate proposal">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_EvaluateProposal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Dup__Evaluate</bpmn:incoming>
      <bpmn:incoming>Flow_Revise__Evaluate</bpmn:incoming>
      <bpmn:incoming>Flow_LateRev__Evaluate</bpmn:incoming>
      <bpmn:outgoing>Flow_Evaluate__Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BE_Remind" name="Review deadline reminder" cancelActivity="false" attachedToRef="Task_Evaluate">
      <bpmn:outgoing>Flow_Remind__Reminder</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BE_Remind_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BE_Escal" name="Continued review delay" cancelActivity="false" attachedToRef="Task_Evaluate">
      <bpmn:outgoing>Flow_Escal__HoD</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BE_Escal_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_Reminder" name="Send committee reminder">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-committee-reminder" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Remind__Reminder</bpmn:incoming>
      <bpmn:outgoing>Flow_Reminder__Reminded</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Reminded" name="Reminder sent">
      <bpmn:incoming>Flow_Reminder__Reminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_HoD" name="HoD expedites delayed review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_HoDExpeditesDelay" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Escal__HoD</bpmn:incoming>
      <bpmn:outgoing>Flow_HoD__HoD</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_HoD" name="Escalation handled">
      <bpmn:incoming>Flow_HoD__HoD</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_Decision" name="Proposal decision" default="Flow_Decision__NotifyRej">
      <bpmn:incoming>Flow_Evaluate__Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision__Rule</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision__RevLimit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision__NotifyRej</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_RevLimit" name="Revision limit reached?" default="Flow_RevLimit__Final">
      <bpmn:incoming>Flow_Decision__RevLimit</bpmn:incoming>
      <bpmn:outgoing>Flow_RevLimit__SendRev</bpmn:outgoing>
      <bpmn:outgoing>Flow_RevLimit__Final</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendRev" name="Send revision comments">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-revision-comments" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RevLimit__SendRev</bpmn:incoming>
      <bpmn:outgoing>Flow_SendRev__Revise</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_Revise" name="Revise proposal">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ReviseProposal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SendRev__Revise</bpmn:incoming>
      <bpmn:outgoing>Flow_Revise__Evaluate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BE_RevDeadline" name="Revision deadline expired" attachedToRef="Task_Revise">
      <bpmn:outgoing>Flow_RevDeadline__MissedRev</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BE_RevDeadline_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_MissedRev" name="Review missed revision deadline">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ReviewMissedRevision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RevDeadline__MissedRev</bpmn:incoming>
      <bpmn:outgoing>Flow_MissedRev__LateRev</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_LateRev" name="Late revision allowed?" default="Flow_LateRev__LapsedRev">
      <bpmn:incoming>Flow_MissedRev__LateRev</bpmn:incoming>
      <bpmn:outgoing>Flow_LateRev__LateRev</bpmn:outgoing>
      <bpmn:outgoing>Flow_LateRev__LapsedRev</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_LateRev" name="Submit revised proposal late">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_SubmitRevisedProposal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LateRev__LateRev</bpmn:incoming>
      <bpmn:outgoing>Flow_LateRev__Evaluate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_LapsedRev" name="Proposal lapsed">
      <bpmn:incoming>Flow_LateRev__LapsedRev</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Final" name="Final proposal decision">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_FinalProposalDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RevLimit__Final</bpmn:incoming>
      <bpmn:outgoing>Flow_Final__Final</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Final" name="Final decision" default="Flow_Final__NotifyRej">
      <bpmn:incoming>Flow_Final__Final</bpmn:incoming>
      <bpmn:outgoing>Flow_Final__Rule</bpmn:outgoing>
      <bpmn:outgoing>Flow_Final__NotifyRej</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyRej" name="Notify student with rejection reasons">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-rejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decision__NotifyRej</bpmn:incoming>
      <bpmn:incoming>Flow_Final__NotifyRej</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyRej__Rejected</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Rejected" name="Proposal rejected">
      <bpmn:incoming>Flow_NotifyRej__Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Task_Rule" name="Check guide availability, workload and domain match">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="guide-allocation-rule" resultVariable="allocationResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decision__Rule</bpmn:incoming>
      <bpmn:incoming>Flow_Final__Rule</bpmn:incoming>
      <bpmn:incoming>Flow_Slot__Rule</bpmn:incoming>
      <bpmn:incoming>Flow_Attempts__Rule</bpmn:incoming>
      <bpmn:incoming>Flow_Team__Rule</bpmn:incoming>
      <bpmn:outgoing>Flow_Rule__Avail</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_Avail" name="Guide available?" default="Flow_Avail__Shortage">
      <bpmn:incoming>Flow_Rule__Avail</bpmn:incoming>
      <bpmn:outgoing>Flow_Avail__Allocate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Avail__Shortage</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Shortage" name="Resolve guide shortage (co-guide, external guide or manual choice)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ResolveGuideShortage" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Avail__Shortage</bpmn:incoming>
      <bpmn:outgoing>Flow_Shortage__Alt</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Alt" name="Alternative guide found?" default="Flow_Alt__Waitlist">
      <bpmn:incoming>Flow_Shortage__Alt</bpmn:incoming>
      <bpmn:outgoing>Flow_Alt__Allocate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Alt__Waitlist</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Team_correct" name="Add team to guide waiting list">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_AddTeamToGuide" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Alt__Waitlist</bpmn:incoming>
      <bpmn:outgoing>Flow_Waitlist__Wait</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="EBG_Wait">
      <bpmn:incoming>Flow_Waitlist__Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait__Slot</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wait__Timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Slot" name="Guide slot freed">
      <bpmn:incoming>Flow_Wait__Slot</bpmn:incoming>
      <bpmn:outgoing>Flow_Slot__Rule</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Slot_def" messageRef="Msg_SlotFreed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_Timer" name="Waiting list expired">
      <bpmn:incoming>Flow_Wait__Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer__Unavail</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Catch_Timer_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Unavail" name="Allocation unavailable">
      <bpmn:incoming>Flow_Timer__Unavail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Allocate" name="Allocate faculty guide">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="allocate-faculty-guide" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Avail__Allocate</bpmn:incoming>
      <bpmn:incoming>Flow_Alt__Allocate</bpmn:incoming>
      <bpmn:outgoing>Flow_Allocate__SendReq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendReq" name="Send allocation request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-allocation-request" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Allocate__SendReq</bpmn:incoming>
      <bpmn:outgoing>Flow_SendReq__GuideReview</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_GuideReview" name="Review allocation request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ReviewAllocationRequest" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SendReq__GuideReview</bpmn:incoming>
      <bpmn:outgoing>Flow_GuideReview__Accepted</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BE_GuideTimeout" name="Guide response timeout" attachedToRef="Task_GuideReview">
      <bpmn:outgoing>Flow_GuideTimeout__Exclude</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BE_GuideTimeout_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BE_Withdraw1" name="Withdrawal or guide cancellation" attachedToRef="Task_GuideReview">
      <bpmn:outgoing>Flow_Withdraw1__Release</bpmn:outgoing>
      <bpmn:messageEventDefinition id="BE_Withdraw1_def" messageRef="Msg_Withdraw" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_Accepted" name="Guide accepted?" default="Flow_Accepted__Exclude">
      <bpmn:incoming>Flow_GuideReview__Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_Accepted__Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Accepted__Exclude</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Exclude" name="Exclude guide and count attempt">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="exclude-guide" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Accepted__Exclude</bpmn:incoming>
      <bpmn:incoming>Flow_GuideTimeout__Exclude</bpmn:incoming>
      <bpmn:outgoing>Flow_Exclude__Attempts</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Attempts" name="Three attempts reached?" default="Flow_Attempts__Manual">
      <bpmn:incoming>Flow_Exclude__Attempts</bpmn:incoming>
      <bpmn:outgoing>Flow_Attempts__Rule</bpmn:outgoing>
      <bpmn:outgoing>Flow_Attempts__Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Manual" name="Manual faculty allocation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ManualFacultyAllocation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Attempts__Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_Manual__Notify</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="Sub_Notify" name="Notify student and record allocation">
      <bpmn:incoming>Flow_Accepted__Notify</bpmn:incoming>
      <bpmn:incoming>Flow_Manual__Notify</bpmn:incoming>
      <bpmn:incoming>Flow_Retry__Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify__Allocated</bpmn:outgoing>
      <bpmn:startEvent id="Sub_Start" name="Allocation confirmed">
        <bpmn:outgoing>Flow_in_Sub_Start</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="Sub_Notify1" name="Notify student">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notify-student" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_in_Sub_Start</bpmn:incoming>
        <bpmn:outgoing>Flow_in_Sub_Notify1</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:serviceTask id="Sub_Record" name="Record confirmed allocation">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-allocation" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_in_Sub_Notify1</bpmn:incoming>
        <bpmn:outgoing>Flow_in_Sub_Record</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Sub_End" name="Allocation recorded">
        <bpmn:incoming>Flow_in_Sub_Record</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_in_Sub_Start" sourceRef="Sub_Start" targetRef="Sub_Notify1" />
      <bpmn:sequenceFlow id="Flow_in_Sub_Notify1" sourceRef="Sub_Notify1" targetRef="Sub_Record" />
      <bpmn:sequenceFlow id="Flow_in_Sub_Record" sourceRef="Sub_Record" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="BE_Error" name="Notification or recording error" attachedToRef="Sub_Notify">
      <bpmn:outgoing>Flow_Error__Retry</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BE_Error_def" errorRef="Err_Notify" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BE_Withdraw2" name="Withdrawal or guide cancellation" attachedToRef="Sub_Notify">
      <bpmn:outgoing>Flow_Withdraw2__Release</bpmn:outgoing>
      <bpmn:messageEventDefinition id="BE_Withdraw2_def" messageRef="Msg_Withdraw" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Retry" name="Wait and count retry">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="count-retry" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Error__Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry__Retry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Retry" name="Retry limit reached?" default="Flow_Retry__ManualNotify">
      <bpmn:incoming>Flow_Retry__Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry__Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retry__ManualNotify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManualNotify" name="Manually notify and record allocation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ManualNotification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Retry__ManualNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualNotify__Allocated</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Allocated" name="Project allocated">
      <bpmn:incoming>Flow_Notify__Allocated</bpmn:incoming>
      <bpmn:incoming>Flow_ManualNotify__Allocated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Release" name="Release reserved guide slot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-guide-slot" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Withdraw1__Release</bpmn:incoming>
      <bpmn:incoming>Flow_Withdraw2__Release</bpmn:incoming>
      <bpmn:outgoing>Flow_Release__Team</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Team" name="Team still active?" default="Flow_Team__Withdrawn">
      <bpmn:incoming>Flow_Release__Team</bpmn:incoming>
      <bpmn:outgoing>Flow_Team__Rule</bpmn:outgoing>
      <bpmn:outgoing>Flow_Team__Withdrawn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Withdrawn" name="Withdrawn">
      <bpmn:incoming>Flow_Team__Withdrawn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Team__Submit" sourceRef="Start_Team" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_Submit__Validate" sourceRef="Task_Submit" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_Validate__Valid" sourceRef="Task_Validate" targetRef="GW_Valid" />
    <bpmn:sequenceFlow id="Flow_Valid__Screen" name="Valid" sourceRef="GW_Valid" targetRef="Task_Screen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validationStatus = "valid"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Valid__TeamRule" name="Invalid team" sourceRef="GW_Valid" targetRef="Task_TeamRule">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validationStatus = "invalid_team"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Valid__Resub" name="Invalid / incomplete" sourceRef="GW_Valid" targetRef="GW_Resub" />
    <bpmn:sequenceFlow id="Flow_Resub__SendErrors" name="No" sourceRef="GW_Resub" targetRef="Task_SendErrors">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validationAttempts &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Resub__Escalate" name="Yes (2 attempts used)" sourceRef="GW_Resub" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_SendErrors__Correct" sourceRef="Task_SendErrors" targetRef="Task_Correct" />
    <bpmn:sequenceFlow id="Flow_Correct__Validate" sourceRef="Task_Correct" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_TeamRule__InvalidTeam" sourceRef="Task_TeamRule" targetRef="End_InvalidTeam" />
    <bpmn:sequenceFlow id="Flow_Escalate__Override" sourceRef="Task_Escalate" targetRef="GW_Override" />
    <bpmn:sequenceFlow id="Flow_Override__Screen" name="Yes" sourceRef="GW_Override" targetRef="Task_Screen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=overrideValidation = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Override__ClosedInvalid" name="No" sourceRef="GW_Override" targetRef="End_ClosedInvalid" />
    <bpmn:sequenceFlow id="Flow_Screen__Dup" sourceRef="Task_Screen" targetRef="Task_Dup" />
    <bpmn:sequenceFlow id="Flow_Dup__Dup" sourceRef="Task_Dup" targetRef="GW_Dup" />
    <bpmn:sequenceFlow id="Flow_Dup__Evaluate" name="No" sourceRef="GW_Dup" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_Dup__ReviewDup" name="Yes" sourceRef="GW_Dup" targetRef="Task_ReviewDup">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=similarityScore &gt;= similarityThreshold</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReviewDup__Modify" sourceRef="Task_ReviewDup" targetRef="GW_Modify" />
    <bpmn:sequenceFlow id="Flow_Modify__Modify" name="Yes" sourceRef="GW_Modify" targetRef="Task_Modify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=topicModifiable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Modify__NotifyDup" name="No" sourceRef="GW_Modify" targetRef="Task_NotifyDup" />
    <bpmn:sequenceFlow id="Flow_Modify__Submit" sourceRef="Task_Modify" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_NotifyDup__Dup" sourceRef="Task_NotifyDup" targetRef="End_Dup" />
    <bpmn:sequenceFlow id="Flow_Deadline__Missed" sourceRef="BE_Deadline" targetRef="Task_Missed" />
    <bpmn:sequenceFlow id="Flow_Missed__ReviewLate" sourceRef="Task_Missed" targetRef="Task_ReviewLate" />
    <bpmn:sequenceFlow id="Flow_ReviewLate__Late" sourceRef="Task_ReviewLate" targetRef="GW_Late" />
    <bpmn:sequenceFlow id="Flow_Late__Submit" name="Yes" sourceRef="GW_Late" targetRef="Task_Submit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=lateApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Late__Lapsed" name="No" sourceRef="GW_Late" targetRef="End_Lapsed" />
    <bpmn:sequenceFlow id="Flow_Evaluate__Decision" sourceRef="Task_Evaluate" targetRef="GW_Decision" />
    <bpmn:sequenceFlow id="Flow_Remind__Reminder" sourceRef="BE_Remind" targetRef="Task_Reminder" />
    <bpmn:sequenceFlow id="Flow_Reminder__Reminded" sourceRef="Task_Reminder" targetRef="End_Reminded" />
    <bpmn:sequenceFlow id="Flow_Escal__HoD" sourceRef="BE_Escal" targetRef="Task_HoD" />
    <bpmn:sequenceFlow id="Flow_HoD__HoD" sourceRef="Task_HoD" targetRef="End_HoD" />
    <bpmn:sequenceFlow id="Flow_Decision__Rule" name="Approved" sourceRef="GW_Decision" targetRef="Task_Rule">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=committeeDecision = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision__RevLimit" name="Revision required" sourceRef="GW_Decision" targetRef="GW_RevLimit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=committeeDecision = "revise"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision__NotifyRej" name="Rejected" sourceRef="GW_Decision" targetRef="Task_NotifyRej" />
    <bpmn:sequenceFlow id="Flow_RevLimit__SendRev" name="No" sourceRef="GW_RevLimit" targetRef="Task_SendRev">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=revisionCount &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RevLimit__Final" name="Yes (2 cycles used)" sourceRef="GW_RevLimit" targetRef="Task_Final" />
    <bpmn:sequenceFlow id="Flow_SendRev__Revise" sourceRef="Task_SendRev" targetRef="Task_Revise" />
    <bpmn:sequenceFlow id="Flow_Revise__Evaluate" sourceRef="Task_Revise" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_RevDeadline__MissedRev" sourceRef="BE_RevDeadline" targetRef="Task_MissedRev" />
    <bpmn:sequenceFlow id="Flow_MissedRev__LateRev" sourceRef="Task_MissedRev" targetRef="GW_LateRev" />
    <bpmn:sequenceFlow id="Flow_LateRev__LateRev" name="Allowed" sourceRef="GW_LateRev" targetRef="Task_LateRev">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=lateRevisionAllowed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_LateRev__LapsedRev" name="Not allowed" sourceRef="GW_LateRev" targetRef="End_LapsedRev" />
    <bpmn:sequenceFlow id="Flow_LateRev__Evaluate" sourceRef="Task_LateRev" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_Final__Final" sourceRef="Task_Final" targetRef="GW_Final" />
    <bpmn:sequenceFlow id="Flow_Final__Rule" name="Approved" sourceRef="GW_Final" targetRef="Task_Rule">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=finalDecision = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Final__NotifyRej" name="Rejected" sourceRef="GW_Final" targetRef="Task_NotifyRej" />
    <bpmn:sequenceFlow id="Flow_NotifyRej__Rejected" sourceRef="Task_NotifyRej" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_Rule__Avail" sourceRef="Task_Rule" targetRef="GW_Avail" />
    <bpmn:sequenceFlow id="Flow_Avail__Allocate" name="Yes" sourceRef="GW_Avail" targetRef="Task_Allocate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=guideAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Avail__Shortage" name="No" sourceRef="GW_Avail" targetRef="Task_Shortage" />
    <bpmn:sequenceFlow id="Flow_Shortage__Alt" sourceRef="Task_Shortage" targetRef="GW_Alt" />
    <bpmn:sequenceFlow id="Flow_Alt__Allocate" name="Yes" sourceRef="GW_Alt" targetRef="Task_Allocate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=alternativeFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Alt__Waitlist" name="No" sourceRef="GW_Alt" targetRef="Team_correct" />
    <bpmn:sequenceFlow id="Flow_Waitlist__Wait" sourceRef="Team_correct" targetRef="EBG_Wait" />
    <bpmn:sequenceFlow id="Flow_Wait__Slot" sourceRef="EBG_Wait" targetRef="Catch_Slot" />
    <bpmn:sequenceFlow id="Flow_Wait__Timer" sourceRef="EBG_Wait" targetRef="Catch_Timer" />
    <bpmn:sequenceFlow id="Flow_Slot__Rule" sourceRef="Catch_Slot" targetRef="Task_Rule" />
    <bpmn:sequenceFlow id="Flow_Timer__Unavail" sourceRef="Catch_Timer" targetRef="End_Unavail" />
    <bpmn:sequenceFlow id="Flow_Allocate__SendReq" sourceRef="Task_Allocate" targetRef="Task_SendReq" />
    <bpmn:sequenceFlow id="Flow_SendReq__GuideReview" sourceRef="Task_SendReq" targetRef="Task_GuideReview" />
    <bpmn:sequenceFlow id="Flow_GuideReview__Accepted" sourceRef="Task_GuideReview" targetRef="GW_Accepted" />
    <bpmn:sequenceFlow id="Flow_Accepted__Notify" name="Yes" sourceRef="GW_Accepted" targetRef="Sub_Notify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=guideAccepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Accepted__Exclude" name="No (declined)" sourceRef="GW_Accepted" targetRef="Task_Exclude" />
    <bpmn:sequenceFlow id="Flow_GuideTimeout__Exclude" sourceRef="BE_GuideTimeout" targetRef="Task_Exclude" />
    <bpmn:sequenceFlow id="Flow_Exclude__Attempts" sourceRef="Task_Exclude" targetRef="GW_Attempts" />
    <bpmn:sequenceFlow id="Flow_Attempts__Rule" name="No" sourceRef="GW_Attempts" targetRef="Task_Rule">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=allocationAttempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Attempts__Manual" name="Yes (3 attempts used)" sourceRef="GW_Attempts" targetRef="Task_Manual" />
    <bpmn:sequenceFlow id="Flow_Manual__Notify" sourceRef="Task_Manual" targetRef="Sub_Notify" />
    <bpmn:sequenceFlow id="Flow_Notify__Allocated" sourceRef="Sub_Notify" targetRef="End_Allocated" />
    <bpmn:sequenceFlow id="Flow_Error__Retry" sourceRef="BE_Error" targetRef="Task_Retry" />
    <bpmn:sequenceFlow id="Flow_Retry__Retry" sourceRef="Task_Retry" targetRef="GW_Retry" />
    <bpmn:sequenceFlow id="Flow_Retry__Notify" name="No" sourceRef="GW_Retry" targetRef="Sub_Notify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryCount &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Retry__ManualNotify" name="Yes (3 retries used)" sourceRef="GW_Retry" targetRef="Task_ManualNotify" />
    <bpmn:sequenceFlow id="Flow_ManualNotify__Allocated" sourceRef="Task_ManualNotify" targetRef="End_Allocated" />
    <bpmn:sequenceFlow id="Flow_Withdraw1__Release" sourceRef="BE_Withdraw1" targetRef="Task_Release" />
    <bpmn:sequenceFlow id="Flow_Withdraw2__Release" sourceRef="BE_Withdraw2" targetRef="Task_Release" />
    <bpmn:sequenceFlow id="Flow_Release__Team" sourceRef="Task_Release" targetRef="GW_Team" />
    <bpmn:sequenceFlow id="Flow_Team__Rule" name="Yes" sourceRef="GW_Team" targetRef="Task_Rule">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=teamActive = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Team__Withdrawn" name="No" sourceRef="GW_Team" targetRef="End_Withdrawn" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_0hy068t">
      <bpmndi:BPMNShape id="Participant_1fsoitw_di" bpmnElement="Participant_1fsoitw" isHorizontal="true">
